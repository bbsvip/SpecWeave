# Pi-native runtime: one long-lived Pi SDK host, never an agent CLI subprocess per turn.
FROM node:22-bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive \
    PROJECTS_ROOT=/data/projects \
    OPENAI_OAUTH_LOCAL_HOME=/auth-local \
    PORT=8090 \
    NODE_ENV=production
WORKDIR /runner
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install --prefix /runner --no-save --ignore-scripts \
       @earendil-works/pi-coding-agent@1.5.2 @earendil-works/pi-ai@1.5.2 typebox \
    && node --input-type=module -e "import {createAgentSession,ModelRuntime,SessionManager,DefaultResourceLoader,SettingsManager,defineTool} from '@earendil-works/pi-coding-agent'; if(!createAgentSession||!ModelRuntime.create||!SessionManager.continueRecent||!DefaultResourceLoader||!SettingsManager.inMemory||!defineTool) process.exit(1)" \
    && useradd -r -u 10001 -m -d /home/specweave specweave \
    && mkdir -p /runner/safe-resources /data/projects /auth-local \
    && chown -R specweave:specweave /runner /data /auth-local \
    && chmod 0700 /auth-local
COPY --chown=specweave:specweave source/pi_host.mjs source/pi_host_oauth.mjs source/pi_host_tools.mjs /runner/
COPY --chown=specweave:specweave source/openai_oauth.mjs source/pi_device_id.mjs /runner/
ENV HOME=/auth-local
USER specweave
EXPOSE 8090
CMD ["node", "/runner/pi_host.mjs"]
