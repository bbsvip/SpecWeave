# Generate random secrets locally as described in README; never commit .env.
APP_PORT=8080
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
# Fernet 32-byte urlsafe base64 key, NOT a password / hex string.
# Generate: python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Keep existing ENCRYPTION_KEY when upgrading; changing it breaks decryption of saved secrets.
ENCRYPTION_KEY=GENERATE_FERNET_KEY
BOOTSTRAP_TOKEN=GENERATE_BOOTSTRAP_TOKEN
COOKIE_SECURE=false
MAX_UPLOAD_MB=40
MAX_UPLOAD_FILES=30
MAX_PROJECT_STORAGE_MB=2048
MAX_PROJECT_FILES=50000
SEARXNG_URL=
SPECWEAVE_CHAT_CONCURRENCY=4
# For compose.external-db.yaml only
DATABASE_URL=

# GitHub Actions prebuilt images: use with compose.external-db.images.yaml or compose.images.yaml.
# Lowercase GitHub owner and repository (without the -web suffix):
# Example: ghcr.io/myname/specweave
SPECWEAVE_IMAGE_REPO=
# main, v1.0.0 (after publishing the Git tag), or sha-<commit prefix>
SPECWEAVE_IMAGE_TAG=main
